<UserControl x:Class="TestProj.view.usercontrol.UserControlTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TestProj.view.usercontrol"
             xmlns:viewmodel="clr-namespace:TestProj.viewmodel"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.DataContext>
        <viewmodel:UserControlTestVM/>
    </UserControl.DataContext>
    
    <Grid>
        <StackPanel
            Orientation="Vertical">
            <TextBox
                x:Name="InputText"
                Text="{Binding TextBox}"
                Width="100"
                Height="20"/>
            <Button
                x:Name="Btn"
                Command="{Binding BtnCmd}"
                CommandParameter="{x:Reference InputText}"
                Content="{StaticResource Okay}"
                Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
        <!--<TextBox
            Width="100"
            Height="20"
            Text="Enter"
            x:Name="InputText"/>
        <Button
            Content="{StaticResource Okay}"
            Style="{StaticResource ButtonStyle}"/>-->
    </Grid>
</UserControl>
